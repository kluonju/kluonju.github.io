---
interface Props {
  title: string;
  authors: string;
  venue: string;
  year: number;
  url?: string;
  pdf?: string;
  bibtex?: string;
  suppPdf?: string;
  arxiv?: string;
  extraLinks?: { label: string; href: string }[];
  index?: number;
}

const { title, authors, venue, year, url, pdf, bibtex, suppPdf, arxiv, extraLinks = [], index } = Astro.props;

const isExternal = (href: string) => /^https?:\/\//i.test(href);

const links = [
  url ? { label: 'Link', href: url } : null,
  arxiv ? { label: 'arXiv', href: `https://arxiv.org/abs/${arxiv}` } : null,
  pdf ? { label: 'PDF', href: pdf } : null,
  bibtex ? { label: 'BibTeX', href: bibtex } : null,
  suppPdf ? { label: 'Supp. PDF', href: suppPdf } : null,
  ...extraLinks,
].filter(Boolean) as { label: string; href: string }[];
---

<li class="pub">
  <div class="pub-body">
    {
      typeof index === 'number' && (
        <span class="num" aria-hidden="true">
          {index}.
        </span>
      )
    }
    <div>
      <p class="title">
        {url ? (
          <a href={url} target="_blank" rel="noopener noreferrer">
            {title}
          </a>
        ) : (
          title
        )}
      </p>
      <p class="authors" set:html={authors} />
      <p class="venue">
        <em>{venue}</em> ({year})
        {arxiv && !url && (
          <>
            {' '}
            <a href={`https://arxiv.org/abs/${arxiv}`} target="_blank" rel="noopener noreferrer">
              arXiv:{arxiv}
            </a>
          </>
        )}
      </p>
      {
        links.length > 0 && (
          <p class="links">
            {links.map((link, i) => (
              <>
                {i > 0 && ' · '}
                <a
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </>
            ))}
          </p>
        )
      }
    </div>
  </div>
</li>

<style>
  .pub {
    list-style: none;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .pub-body {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
  }

  .num {
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
    font-weight: 600;
    min-width: 1.5rem;
  }

  .title {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-teal);
  }

  .authors,
  .venue,
  .links {
    margin: 0 0 0.3rem;
    font-size: 0.95rem;
  }

  .authors {
    color: var(--color-ink-soft);
  }

  .venue {
    color: var(--color-muted);
  }

  .links {
    margin-top: 0.35rem;
  }

  .links a {
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
</style>
