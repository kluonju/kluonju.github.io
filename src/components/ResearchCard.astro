---
import Bi from './Bi.astro';
import { ui } from '../i18n/ui';

interface Props {
  title: string;
  summary: string;
  href: string;
}

const { title, summary, href } = Astro.props;
---

<article class="research-card">
  <h3>{title}</h3>
  <p>{summary}</p>
  <a class="more" href={href}>
    <Bi en={ui.en.exploreResearch} zh={ui.zh.exploreResearch} />
  </a>
</article>

<style>
  .research-card {
    border: none;
    padding: 0;
  }

  h3 {
    margin: 0 0 0.55rem;
  }

  p {
    color: var(--color-ink-soft);
    margin: 0 0 0.85rem;
    max-width: 34rem;
  }

  .more {
    font-weight: 600;
    text-decoration: none;
  }
</style>
