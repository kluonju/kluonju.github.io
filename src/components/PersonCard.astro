---
interface Props {
  name: string;
  nameZh?: string;
  role: string;
  researchArea?: string;
  years?: string;
  photo?: string;
  contact?: string;
  thesis?: string;
  destination?: string;
  compact?: boolean;
  cvHref?: string;
}

const {
  name,
  nameZh,
  role,
  researchArea,
  years,
  photo,
  contact,
  thesis,
  destination,
  compact = false,
  cvHref,
} = Astro.props;

const roleLabel: Record<string, string> = {
  pi: 'Principal Investigator',
  graduate: 'Graduate',
  undergrad: 'Undergraduate',
  alumni: 'Alumni',
};
---

<article class:list={['person', { compact }]}>
  {
    photo && (
      <img class="photo" src={photo} alt={`Photo of ${name}`} width="150" height="200" loading="lazy" />
    )
  }
  <div class="meta">
    <h3>
      {name}
      {nameZh && <span class="zh">（{nameZh}）</span>}
    </h3>
    <p class="role">{roleLabel[role] ?? role}</p>
    {years && <p><span class="label">Years</span> {years}</p>}
    {researchArea && <p><span class="label">Research</span> {researchArea}</p>}
    {contact && <p><span class="label">Contact</span> {contact}</p>}
    {thesis && <p><span class="label">Thesis</span> {thesis}</p>}
    {destination && <p><span class="label">Next</span> {destination}</p>}
    {cvHref && (
      <p class="cv-link">
        <a href={cvHref}>Curriculum Vitae →</a>
      </p>
    )}
  </div>
</article>

<style>
  .person {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .person.compact {
    grid-template-columns: 88px 1fr;
    gap: 0.85rem;
  }

  .photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--color-paper-warm);
  }

  h3 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  .zh {
    font-weight: 500;
    color: var(--color-muted);
  }

  .role {
    margin: 0 0 0.55rem;
    color: var(--color-teal);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .meta p {
    margin: 0 0 0.35rem;
    font-size: 0.95rem;
  }

  .label {
    display: inline-block;
    min-width: 4.5rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cv-link {
    margin-top: 0.55rem;
  }

  .cv-link a {
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 520px) {
    .person,
    .person.compact {
      grid-template-columns: 96px 1fr;
    }
  }
</style>
