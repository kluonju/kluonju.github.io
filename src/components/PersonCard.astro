---
import Bi from './Bi.astro';
import { ui } from '../i18n/ui';

interface Props {
  name: string;
  nameZh?: string;
  role: string;
  researchArea?: string;
  years?: string;
  photo?: string;
  contact?: string;
  thesis?: string;
  destination?: string;
  compact?: boolean;
  cvHref?: string;
}

const {
  name,
  nameZh,
  role,
  researchArea,
  years,
  photo,
  contact,
  thesis,
  destination,
  compact = false,
  cvHref,
} = Astro.props;

const roleEn: Record<string, string> = {
  pi: ui.en.rolePi,
  graduate: ui.en.roleGraduate,
  undergrad: ui.en.roleUndergrad,
  alumni: ui.en.roleAlumni,
};
const roleZh: Record<string, string> = {
  pi: ui.zh.rolePi,
  graduate: ui.zh.roleGraduate,
  undergrad: ui.zh.roleUndergrad,
  alumni: ui.zh.roleAlumni,
};
---

<article class:list={['person', { compact }]}>
  {
    photo && (
      <img class="photo" src={photo} alt={`Photo of ${name}`} width="150" height="200" loading="lazy" />
    )
  }
  <div class="meta">
    <h3>
      {name}
      {nameZh && <span class="zh">（{nameZh}）</span>}
    </h3>
    <p class="role">
      <Bi en={roleEn[role] ?? role} zh={roleZh[role] ?? role} />
    </p>
    {
      years && (
        <p>
          <span class="label"><Bi en={ui.en.labelYears} zh={ui.zh.labelYears} /></span>
          {years}
        </p>
      )
    }
    {
      researchArea && (
        <p>
          <span class="label"><Bi en={ui.en.labelResearch} zh={ui.zh.labelResearch} /></span>
          {researchArea}
        </p>
      )
    }
    {
      contact && (
        <p>
          <span class="label"><Bi en={ui.en.labelContact} zh={ui.zh.labelContact} /></span>
          {contact}
        </p>
      )
    }
    {
      thesis && (
        <p>
          <span class="label"><Bi en={ui.en.labelThesis} zh={ui.zh.labelThesis} /></span>
          {thesis}
        </p>
      )
    }
    {
      destination && (
        <p>
          <span class="label"><Bi en={ui.en.labelNext} zh={ui.zh.labelNext} /></span>
          {destination}
        </p>
      )
    }
    {
      cvHref && (
        <p class="cv-link">
          <a href={cvHref}>
            <Bi en={ui.en.cv} zh={ui.zh.cv} />
          </a>
        </p>
      )
    }
  </div>
</article>

<style>
  .person {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .person.compact {
    grid-template-columns: 88px 1fr;
  }

  .photo {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--color-paper-warm);
  }

  .meta h3 {
    margin: 0 0 0.25rem;
    font-size: 1.15rem;
  }

  .zh {
    font-weight: 500;
    color: var(--color-muted);
    font-size: 0.92em;
  }

  .role {
    margin: 0 0 0.55rem;
    color: var(--color-teal);
    font-weight: 600;
    font-size: 0.92rem;
  }

  .meta p {
    margin: 0 0 0.3rem;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
  }

  .label {
    color: var(--color-muted);
    font-weight: 600;
    margin-right: 0.35rem;
  }

  .cv-link {
    margin-top: 0.55rem !important;
  }

  .cv-link a {
    font-weight: 600;
    text-decoration: none;
  }
</style>
