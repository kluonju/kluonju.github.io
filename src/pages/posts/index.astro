---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bi from '../../components/Bi.astro';
import { ui } from '../../i18n/ui';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Blog" titleZh="博客" description="Notes and software install diaries from Luo's Theory Lab.">
  <div class="page">
    <div class="container-narrow">
      <header class="page-header">
        <h1><Bi en={ui.en.navBlog} zh={ui.zh.navBlog} /></h1>
        <p>
          Computational notes and install diaries.
          <a href="/posts/archives/"><Bi en={ui.en.archive} zh={ui.zh.archive} /></a>
        </p>
      </header>

      <ul class="post-list">
        {
          posts.map((post) => (
            <li>
              <a href={`/posts/${post.id}/`}>
                <h2>{post.data.title}</h2>
              </a>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .post-list h2 {
    margin: 0 0 0.25rem;
    font-size: 1.2rem;
  }

  .post-list a {
    color: inherit;
    text-decoration: none;
  }

  .post-list a:hover h2 {
    color: var(--color-teal);
  }

  time {
    color: var(--color-muted);
    font-size: 0.9rem;
  }
</style>
