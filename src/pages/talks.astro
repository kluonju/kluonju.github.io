---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const talks = (await getCollection('talks'))
  .filter((t) => !t.data.draft)
  .sort((a, b) => {
  const da = a.data.date?.valueOf() ?? 0;
  const db = b.data.date?.valueOf() ?? 0;
  return db - da;
});
---

<BaseLayout title="Talks" description="Talks and seminars from Luo's Theory Lab.">
  <div class="page">
    <div class="container-narrow">
      <header class="page-header">
        <h1>Talks</h1>
        <p>Invited talks, seminars, and conference presentations.</p>
      </header>

      {
        talks.length === 0 ? (
          <p class="empty">Talk listings will appear here as they are added.</p>
        ) : (
          <ul class="talk-list">
            {talks.map((talk) => (
              <li>
                <h2>{talk.data.title}</h2>
                <p class="meta">
                  {[talk.data.event, talk.data.location, talk.data.date?.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
                <p class="links">
                  {talk.data.url && <a href={talk.data.url}>Details</a>}
                  {talk.data.slides && (
                    <>
                      {talk.data.url && ' · '}
                      <a href={talk.data.slides}>Slides</a>
                    </>
                  )}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .empty {
    color: var(--color-muted);
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .talk-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .talk-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .talk-list h2 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }

  .meta,
  .links {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .links {
    margin-top: 0.35rem;
  }
</style>
