---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bi from '../components/Bi.astro';
import { ui } from '../i18n/ui';

const talks = (await getCollection('talks'))
  .filter((t) => !t.data.draft)
  .sort((a, b) => {
    const da = a.data.date?.valueOf() ?? 0;
    const db = b.data.date?.valueOf() ?? 0;
    return db - da;
  });

const rendered = await Promise.all(
  talks.map(async (talk) => {
    const { Content } = await render(talk);
    const hasAbstract = Boolean(talk.body?.trim());
    return { talk, Content, hasAbstract };
  }),
);

const sections = [
  {
    key: 'invited' as const,
    items: rendered.filter((t) => t.talk.data.kind === 'invited'),
    en: ui.en.talksInvited,
    zh: ui.zh.talksInvited,
  },
  {
    key: 'contributed' as const,
    items: rendered.filter((t) => t.talk.data.kind === 'contributed'),
    en: ui.en.talksContributed,
    zh: ui.zh.talksContributed,
  },
];
---

<BaseLayout title="Talks" titleZh="报告" description="Talks and seminars from Luo's Theory Lab.">
  <div class="page">
    <div class="container-narrow">
      <header class="page-header">
        <h1><Bi en={ui.en.navTalks} zh={ui.zh.navTalks} /></h1>
        <p>Invited and contributed talks.</p>
      </header>

      {
        talks.length === 0 ? (
          <p class="empty"><Bi en={ui.en.talksEmpty} zh={ui.zh.talksEmpty} /></p>
        ) : (
          sections.map(
            (section) =>
              section.items.length > 0 && (
                <section class="talk-section" aria-labelledby={`talks-${section.key}`}>
                  <h2 id={`talks-${section.key}`} class="section-title">
                    <Bi en={section.en} zh={section.zh} />
                  </h2>
                  <ul class="talk-list">
                    {section.items.map(({ talk, Content, hasAbstract }) => (
                      <li>
                        <h3>{talk.data.title}</h3>
                        <p class="meta">
                          {[
                            talk.data.event,
                            talk.data.location,
                            talk.data.date?.toLocaleDateString('en-US', {
                              year: 'numeric',
                              month: 'short',
                            }),
                          ]
                            .filter(Boolean)
                            .join(' · ')}
                        </p>
                        {hasAbstract && (
                          <div class="abstract">
                            <p class="abstract-label">
                              <Bi en={ui.en.talksAbstract} zh={ui.zh.talksAbstract} />
                            </p>
                            <div class="abstract-body prose">
                              <Content />
                            </div>
                          </div>
                        )}
                        {(talk.data.url || talk.data.slides) && (
                          <p class="links">
                            {talk.data.url && <a href={talk.data.url}>Details</a>}
                            {talk.data.slides && (
                              <>
                                {talk.data.url && ' · '}
                                <a href={talk.data.slides}>Slides</a>
                              </>
                            )}
                          </p>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              ),
          )
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .empty {
    color: var(--color-muted);
    padding: 1.5rem 0;
    border-top: 1px solid var(--color-line);
  }

  .talk-section + .talk-section {
    margin-top: 2.25rem;
  }

  .section-title {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-teal);
  }

  .talk-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .talk-list li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .talk-list h3 {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .meta,
  .links {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .abstract {
    margin-top: 0.85rem;
  }

  .abstract-label {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-teal);
  }

  .abstract-body {
    color: var(--color-ink-soft);
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .abstract-body :global(p) {
    margin: 0 0 0.65rem;
  }

  .abstract-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .links {
    margin-top: 0.65rem;
  }
</style>
